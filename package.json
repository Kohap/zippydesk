{
  "name": "zippydesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "server": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "demo:playground": "node --import tsx scripts/playground.ts",
    "demo:vision": "node --env-file=.env --import tsx scripts/vision-demo.ts",
    "check:db": "node --env-file=.env --import tsx scripts/db-check.ts",
    "check:redis": "node --env-file=.env --import tsx scripts/redis-check.ts",
    "check:live": "node --env-file=.env --import tsx scripts/live-check.ts",
    "qa:seed": "node --env-file=.env --import tsx scripts/qa-seed.ts",
    "qa:visual": "node --import tsx scripts/qa-visual.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "bullmq": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "playwright-core": "^1.62.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
